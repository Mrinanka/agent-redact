{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<CONFIG-FOLDER>/aegiscontext/backup/backup/main.js"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<CONFIG-FOLDER>/aegiscontext/backup/backup/main.js"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<CONFIG-FOLDER>/aegiscontext/backup/backup/main.js"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
