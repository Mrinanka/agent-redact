{
  "name": "secret-shield",
  "version": "0.0.0",
  "description": "Hides secrets before the model sees them in Claude Code (working name).",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "leak-test": "node tools/leak-test/run.ts",
    "leak-test:baseline": "node tools/leak-test/run.ts --expect leaks --plugin tools/leak-test/fixtures/empty-plugin",
    "rules:build": "node tools/rules/build.ts",
    "measure": "node tools/measure/run.ts",
    "measure:store": "node tools/measure/store.ts",
    "plugin:build": "node tools/plugin/build.ts",
    "plugin:typecheck": "node tools/plugin/typecheck.ts",
    "leak-test:core": "node tools/leak-test/run.ts --plugin plugin --only prompt-typed --only prompt-pasted --only read-file --only bash-output --only bash-failed --only bash-large --only mcp-result --only subagent-read --only compaction --only claude-md --only hook-context",
    "leak-test:backup": "node tools/leak-test/run.ts --no-plugin --backup user",
    "leak-test:backup-limits": "node tools/leak-test/run.ts --no-plugin --backup user --outside",
    "leak-test:managed": "node tools/leak-test/run.ts --no-plugin --backup managed --safe-mode --allow-managed-file"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
